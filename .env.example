# ─── Copy this file to .env and fill in your real values ───────────────────

# Django core
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=amaljith0003.pythonanywhere.com

# ─── Database ───────────────────────────────────────────────────────────────
# Set to 'mysql' for PythonAnywhere, leave as 'sqlite' for local dev
DB_ENGINE=mysql

# PythonAnywhere MySQL credentials
# Found in: PythonAnywhere Dashboard → Databases tab
DB_NAME=amaljith0003$eventstore
DB_USER=amaljith0003
DB_PASSWORD=your-mysql-password-here
DB_HOST=amaljith0003.mysql.pythonanywhere-services.com
DB_PORT=3306

# ─── Email (optional – needed for password reset emails) ────────────────────
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
